// Prisma Schema para A&B OS (ERP-TRANSSERVICES)
// Configurado para PostgreSQL en Railway

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// MÓDULO PERSONAS Y EXPEDIENTE LABORAL / CONDUCTOR
// --------------------------------------------------------

model Persona {
  id                String             @id @default(cuid())
  nombres           String
  apellidos         String
  tipoDocumento     String             @default("CC") // CC, CE, PA, TI
  numeroDocumento   String             @unique
  telefono          String
  email             String
  perfiles          String[]           // conductor, empleado, supervisor, hseq, administrativo
  estado            String             @default("activo") // activo, inactivo, descanso, vacaciones
  fechaIngreso      DateTime           @default(now())
  contratistaId     String?
  contratistaNombre String?
  fotoIniciales     String
  pin               String?            @default("1234")
  passwordHash      String?

  // Relaciones
  licenciaConduccion LicenciaConduccion?
  examenMedico       ExamenMedico?
  datosSalud         DatosSalud?
  contactoEmergencia ContactoEmergencia?
  asignaciones       Asignacion[]

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([numeroDocumento])
  @@index([estado])
}

model LicenciaConduccion {
  id                String   @id @default(cuid())
  personaId         String   @unique
  persona           Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  numero            String
  categorias        String[] // C1, C2, C3, B1, B2, etc.
  fechaVencimiento  DateTime
  organismoTransito String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ExamenMedico {
  id                String   @id @default(cuid())
  personaId         String   @unique
  persona           Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  tipo              String   @default("periodico") // ingreso, periodico, egreso, post_incapacidad
  fechaRealizacion  DateTime
  fechaVigencia     DateTime
  enfasis           String[] // Visiometría, Audiometría, Psicosensométrico, Osteomuscular
  concepto          String   @default("apto") // apto, apto_con_restricciones, no_apto, pendiente
  restricciones     String?
  centroMedico      String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DatosSalud {
  id                String   @id @default(cuid())
  personaId         String   @unique
  persona           Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  grupoSanguineoRH  String   // O+, O-, A+, A-, B+, B-, AB+, AB-
  eps               String
  arl               String
  fondoPensiones    String?
  alergias          String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ContactoEmergencia {
  id                String   @id @default(cuid())
  personaId         String   @unique
  persona           Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  nombreCompleto    String
  parentesco        String
  telefono          String

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// --------------------------------------------------------
// MÓDULO CONTRATISTAS
// --------------------------------------------------------

model Contratista {
  id                String       @id @default(cuid())
  razonSocial       String
  nit               String       @unique
  tipoOperacion     String       @default("fija") // fija, rotativa
  contactoNombre    String?
  telefono          String
  email             String
  direccion         String?
  estado            String       @default("activo") // activo, inactivo
  fechaVinculacion  DateTime     @default(now())
  fechaFinContrato  DateTime?
  notas             String?
  vehiculos         Vehiculo[]
  asignaciones      Asignacion[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// --------------------------------------------------------
// MÓDULO FLOTA (VEHÍCULOS)
// --------------------------------------------------------

model Vehiculo {
  id                String       @id @default(cuid())
  placa             String       @unique
  marca             String
  modelo            String
  anio              Int
  capacidad         Int
  tipo              String       // van, microbus, buseta, bus, camioneta, automovil
  servicio          String       @default("especial") // especial, particular, publico
  contratistaId     String?
  contratista       Contratista? @relation(fields: [contratistaId], references: [id], onDelete: SetNull)
  contratistaNombre String
  estado            String       @default("activo") // activo, mantenimiento, inactivo

  // Vencimientos documentales
  soatVencimiento   DateTime
  rtmVencimiento    DateTime
  polizaVencimiento DateTime

  asignaciones      Asignacion[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([placa])
  @@index([estado])
}

// --------------------------------------------------------
// MÓDULO ASIGNACIONES
// --------------------------------------------------------

model Asignacion {
  id                String       @id @default(cuid())
  conductorId       String
  conductor         Persona      @relation(fields: [conductorId], references: [id], onDelete: Cascade)
  conductorNombre   String
  vehiculoId        String
  vehiculo          Vehiculo     @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  placa             String
  contratistaId     String?
  contratista       Contratista? @relation(fields: [contratistaId], references: [id], onDelete: SetNull)
  contratistaNombre String
  tipoAsignacion    String       // fija, rotativa
  turno             String?      // 12h-diurno, 12h-nocturno, 24h
  fechaInicio       DateTime
  fechaFin          DateTime?
  estado            String       @default("activa") // activa, programada, finalizada
  observaciones     String?
  autorizacionOperativa Boolean  @default(false)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([conductorId])
  @@index([vehiculoId])
  @@index([estado])
}

// --------------------------------------------------------
// DOCUMENTOS Y ARCHIVOS ADJUNTOS
// --------------------------------------------------------

model DocumentoAdjunto {
  id                String   @id @default(cuid())
  entidadTipo       String   // persona, vehiculo, contratista, sgsst, pesv, hseq
  entidadId         String
  tipoDocumento     String   // cedula, licencia, emo, pila, soat, rtm, poliza, contrato, evidencia
  nombre            String
  archivoUrl        String
  tamano            String?
  mimeType          String?
  fechaVencimiento  DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([entidadTipo, entidadId])
}

// --------------------------------------------------------
// MÓDULO OPERACIÓN & VIAJES
// --------------------------------------------------------

model Viaje {
  id                    String         @id @default(cuid())
  conductorId           String
  conductorNombre       String
  vehiculoId            String
  placa                 String
  contratistaNombre     String
  origen                String
  destino               String
  servicio              String         @default("especial") // especial, escolar, turismo
  fechaSalida           DateTime
  duracionEstimadaHoras Float          @default(2.0)
  fechaLlegadaReal      DateTime?
  horaSalida            String?
  horaLlegada           String?
  distanciaKm           Float?
  riskScore             Int?
  riskLevel             String?
  riskInputs            Json?
  signatures            Json?
  estado                String         @default("en_curso") // programado, en_curso, finalizado, con_novedad, Pendiente, Pendiente HSE, Autorizado
  observaciones         String?
  novedades             NovedadViaje[]

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([conductorId])
  @@index([vehiculoId])
  @@index([estado])
  @@index([placa])
}

model NovedadViaje {
  id          String   @id @default(cuid())
  viajeId     String
  viaje       Viaje    @relation(fields: [viajeId], references: [id], onDelete: Cascade)
  fecha       DateTime @default(now())
  descripcion String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([viajeId])
}

// --------------------------------------------------------
// MÓDULO TELEMETRÍA GPS & MONITOREO PESV (Satelcopro / n8n)
// --------------------------------------------------------

model EventoGPS {
  id                      String    @id @default(cuid())
  placa                   String
  fechaHora               DateTime  @default(now())
  tipoEvento              String    // overspeed, frenada_brusca, acelerada_brusca, panico, etc.
  prioridad               String    @default("media") // alta, media, baja / informativa
  descripcion             String
  velocidad               Float?
  limiteVelocidad         Float?
  odometro                Float?
  latitud                 Float?
  longitud                Float?
  ubicacion               String?
  conductorId             String?
  conductorNombre         String?
  conductorTelefono       String?
  conductorEmail          String?
  estadoRetroalimentacion String    @default("pendiente") // pendiente, enviada_whatsapp, enviada_correo, resuelta
  fechaRetroalimentacion  DateTime?
  observacionesGestion    String?

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([placa])
  @@index([fechaHora])
  @@index([prioridad])
  @@index([conductorId])
}

// --------------------------------------------------------
// CONTRATOS DE TRANSPORTE & FUEC (MINISTERIO DE TRANSPORTE)
// --------------------------------------------------------

model ContratoTransporte {
  id                String   @id @default(cuid())
  numeroContrato    String   @unique
  contratanteNombre String
  contratanteNit    String
  objetoContrato    String   // empresarial, escolar, turismo, grupo_usuarios
  fechaInicio       DateTime
  fechaFin          DateTime
  estado            String   @default("activo") // activo, finalizado, cancelado
  fuecs             Fuec[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Fuec {
  id                        String              @id @default(cuid())
  numeroConsecutivo         Int                 @default(autoincrement())
  codigoFUEC                String              @unique
  contratoId                String
  contrato                  ContratoTransporte  @relation(fields: [contratoId], references: [id])
  contratoNumero            String
  contratante               String
  objetoContrato            String
  origen                    String
  destino                   String
  rutaDetalle               String?
  vehiculoId                String
  placa                     String
  marca                     String
  modelo                    String
  tarjetaOperacionNumero    String?
  conductorPrincipalId      String
  conductorPrincipalNombre  String
  conductorSecundarioId     String?
  conductorSecundarioNombre String?
  fechaInicio               DateTime
  fechaFin                  DateTime
  estado                    String              @default("emitido") // emitido, vencido, anulado
  qrCodeUrl                 String?
  observaciones             String?

  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  @@index([codigoFUEC])
  @@index([placa])
  @@index([fechaInicio, fechaFin])
}

// --------------------------------------------------------
// PORTAL CONDUCTOR & PREOPERACIONAL DIARIO (PESV PASO 14)
// --------------------------------------------------------

model NovedadConductor {
  id                    String   @id @default(cuid())
  conductorId           String
  conductorNombre       String
  vehiculoId            String?
  placa                 String?
  tipo                  String   // mecanica, vial, seguridad, otro
  descripcion           String
  fotoUrl               String?
  fecha                 DateTime @default(now())
  atendida              Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([conductorId])
  @@index([fecha])
}

model InspeccionPreoperacional {
  id                    String   @id @default(cuid())
  conductorId           String
  conductorNombre       String
  vehiculoId            String
  placa                 String
  fecha                 DateTime @default(now())
  kilometraje           Float?
  checklist             Json     // { [item: string]: boolean }
  hallazgoDetectado     Boolean  @default(false)
  descripcionHallazgo   String?
  fotoEvidenciaUrl      String?
  estadoConcepto        String   @default("apto") // apto, no_apto, apto_con_observacion

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([conductorId])
  @@index([placa])
  @@index([fecha])
}

// --------------------------------------------------------
// MÓDULO HSEQ & HALLAZGOS
// --------------------------------------------------------

model HallazgoHseq {
  id                  String   @id @default(cuid())
  origen              String   // preoperacional, inspeccion, incidente, accidente
  titulo              String
  descripcion         String
  severidad           String   @default("media") // baja, media, alta, critica
  estado              String   @default("abierto") // abierto, en_proceso, cerrado
  vehiculoId          String?
  placa               String?
  conductorId         String?
  conductorNombre     String?
  responsable         String
  fechaReporte        DateTime @default(now())
  fechaCierre         DateTime?
  accionCorrectiva    String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([estado])
  @@index([severidad])
  @@index([fechaReporte])
}

// --------------------------------------------------------
// SG-SST (DECRETO 1072 & RESOLUCIÓN 0312 DE 2019)
// --------------------------------------------------------

model ItemSgsst {
  id                  String   @id @default(cuid())
  numeral             String   // ej. "1.1.1"
  estandarId          String
  nombre              String
  estado              String   @default("pendiente") // cumple, cumple_parcial, no_cumple, no_aplica, pendiente
  responsable         String?
  documentoNombre     String?
  fechaActualizacion  DateTime?
  observaciones       String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([estandarId])
  @@index([estado])
}

// --------------------------------------------------------
// PESV (RESOLUCIÓN 40595 DE 2022 - 24 PASOS)
// --------------------------------------------------------

model PasoPesv {
  id                  String   @id @default(cuid())
  numero              Int      @unique
  fase                String   // planificacion, implementacion, seguimiento, mejora
  nombre              String
  estado              String   @default("pendiente") // cumple, cumple_parcial, no_cumple, no_aplica, pendiente
  documentoNombre     String?
  observaciones       String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([fase])
  @@index([estado])
}

model IndicadorPesv {
  id                  String   @id @default(cuid())
  nombre              String
  periodicidad        String   // mensual, trimestral, anual
  unidad              String
  descripcion         String
  valorActual         Float?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// --------------------------------------------------------
// CAPACITACIONES, ASISTENCIA Y ENCUESTAS
// --------------------------------------------------------

model Capacitacion {
  id                  String   @id @default(cuid())
  nombre              String
  tipo                String   @default("sg-sst") // sg-sst, pesv, hseq, operativa
  fecha               DateTime
  duracionHoras       Float    @default(1.0)
  asistentesEsperados Int      @default(0)
  asistentesReales    Int?
  estado              String   @default("programada") // programada, realizada, cancelada

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tipo])
  @@index([estado])
}

model AsistenciaRegistro {
  id                  String   @id @default(cuid())
  capacitacionId      String?
  personaId           String?
  personaDocumento    String?
  personaNombre       String
  cargo               String?
  proyecto            String?
  facilitador         String?
  lugar               String?
  duracionHoras       Float?   @default(1.0)
  asistio             Boolean  @default(true)
  estado              String   @default("presente") // presente, tardanza, ausente
  horaLlegada         String?
  evento              String?  @default("Jornada Operativa / Capacitación")
  tipoEvento          String   @default("capacitacion") // capacitacion, reunion, turno, etc.
  firmaUrl            String?
  fotoUrl             String?
  observaciones       String?
  fecha               DateTime @default(now())

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([capacitacionId])
  @@index([personaId])
  @@index([personaDocumento])
  @@index([proyecto])
  @@index([fecha])
}

model EncuestaRiesgoVial {
  id                  String   @id @default(cuid())
  personaId           String
  personaNombre       String
  fecha               DateTime @default(now())
  respuestas          Json
  nivelRiesgo         String   @default("medio") // bajo, medio, alto

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([personaId])
}

// --------------------------------------------------------
// ADMINISTRACIÓN & CONTROL DE ACCESO (RBAC)
// --------------------------------------------------------

model RolSistema {
  id                  String   @id @default(cuid())
  nombre              String   @unique
  descripcion         String
  permisos            Json     @default("[]") // Lista de módulos accesibles
  esConfigurable      Boolean  @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

