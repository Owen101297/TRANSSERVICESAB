# Base de datos PostgreSQL (En Railway se inyecta automáticamente cuando agregas PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ab_os?schema=public"

# Genere valores aleatorios diferentes por ambiente (mínimo 32 caracteres)
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
GPS_WEBHOOK_API_KEY="replace-with-a-random-webhook-key"

# Cuenta documental de Google Drive (OAuth 2.0, alcance drive.file)
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
# Opcional: carpeta creada o seleccionada para centralizar las evidencias
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# Secreto compartido con el activador de Google Forms (Apps Script)
GOOGLE_FORMS_WEBHOOK_SECRET="replace-with-a-random-webhook-key"
# Aplicación web del conector central de Apps Script
GOOGLE_FORMS_CONNECTOR_URL=""
GOOGLE_FORMS_CONNECTOR_SECRET="replace-with-a-different-random-secret"

# Origen público usado por integraciones y enlaces externos
PUBLIC_APP_URL="http://localhost:3000"

# Configuración del entorno
NODE_ENV="development"
